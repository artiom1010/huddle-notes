# All settings of huddle-notes, in one place.
# Copy to .env and fill in. .env is never committed: secrets live here too.
# The program reads ./.env by itself (or the file given with --env).

# --- Models (see the README: "Какие модели работают") ---------------------------
# Speech to text. Options: large-v3-turbo (default), large-v3
HUDDLE_WHISPER_MODEL=large-v3-turbo
# Voices. Options: wespeaker-resnet34
HUDDLE_VOICE_MODEL=wespeaker-resnet34
# Notes, through Claude Code. Options: claude-opus-5-5, claude-sonnet-5-5
HUDDLE_NOTES_MODEL=claude-opus-5-5
# Claude Code uses the account this computer is signed in with, or this key from
# `claude setup-token` when the computer is signed in under another account:
# CLAUDE_CODE_OAUTH_TOKEN=
# HUDDLE_CLAUDE_BIN=claude
# whisper.cpp command line tool
# HUDDLE_WHISPER_BIN=whisper-cli

# --- Calls ------------------------------------------------------------------------
# Team glossary for whisper: <data>/glossaries/<name>.txt
HUDDLE_GLOSSARY=староста
# Time zone for the date and time in each call's document
HUDDLE_TIMEZONE=Europe/Chisinau

# --- Slack (the watcher sends each result here) -----------------------------------
# Bot token of the app (xoxb-...); channel ID (not the name); member ID to @mention
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_NOTIFY_USER=

# --- Where things are ------------------------------------------------------------
# People library, glossaries, models (<data>/models), work files. Outside the repository.
# «Записи» (inbox) and «Результаты» (results) sit next to it unless set below.
HUDDLE_DATA_DIR=/srv/huddle-notes/data
# HUDDLE_INBOX=/srv/huddle-notes/Записи
# HUDDLE_RESULTS=/srv/huddle-notes/Результаты
# Hardware video decoding: videotoolbox on a Mac; empty elsewhere
HUDDLE_HWACCEL=

# Host folders mounted into the container by docker-compose.yml
HUDDLE_HOST_DATA=/srv/huddle-notes/data
HUDDLE_HOST_CALLS=/srv/huddle-notes/calls
HUDDLE_HOST_REGRESSION=/srv/huddle-notes/regression
