# Copy to .env and fill in. .env is never committed.

# People library, glossaries and models (<data>/models). Outside the repository.
HUDDLE_DATA_DIR=/srv/huddle-notes/data

# whisper.cpp command line tool (in the Docker image: whisper-cli)
# HUDDLE_WHISPER_BIN=whisper-cli

# Hardware video decoding: videotoolbox on a Mac; leave empty on the server
HUDDLE_HWACCEL=

# Host folders mounted into the container by docker-compose.yml
HUDDLE_HOST_DATA=/srv/huddle-notes/data
HUDDLE_HOST_CALLS=/srv/huddle-notes/calls
HUDDLE_HOST_REGRESSION=/srv/huddle-notes/regression
