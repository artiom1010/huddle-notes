# All settings of huddle-notes, in one place.
# Copy to .env and fill in. .env is never committed: secrets will live here too.

# --- Models (see the README: "Какие модели работают") ---------------------------
# Speech to text. Options: large-v3-turbo (default), large-v3
HUDDLE_WHISPER_MODEL=large-v3-turbo
# Voices. Options: wespeaker-resnet34
HUDDLE_VOICE_MODEL=wespeaker-resnet34
# Notes, through the company's Claude account. Options: claude-opus-5-5, claude-sonnet-5-5
HUDDLE_NOTES_MODEL=claude-opus-5-5

# --- Where things are ------------------------------------------------------------
# People library, glossaries and models (in <data>/models). Outside the repository.
HUDDLE_DATA_DIR=/srv/huddle-notes/data
# Time zone for the date and time in each call's document
HUDDLE_TIMEZONE=Europe/Chisinau
# Hardware video decoding: videotoolbox on a Mac; empty on the server
HUDDLE_HWACCEL=

# Host folders mounted into the container by docker-compose.yml
HUDDLE_HOST_DATA=/srv/huddle-notes/data
HUDDLE_HOST_CALLS=/srv/huddle-notes/calls
HUDDLE_HOST_REGRESSION=/srv/huddle-notes/regression
