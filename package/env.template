# Huddle Notes settings. Paths are relative to this folder (the watcher runs from here).
# Secrets are written here by the owner, never pasted into a chat.

# --- Folders --------------------------------------------------------------------
HUDDLE_DATA_DIR=данные
# HUDDLE_INBOX=Записи
# HUDDLE_RESULTS=Результаты

# --- Models -----------------------------------------------------------------------
HUDDLE_WHISPER_MODEL=large-v3-turbo
HUDDLE_VOICE_MODEL=wespeaker-resnet34
HUDDLE_NOTES_MODEL=claude-opus-5-5
HUDDLE_WHISPER_BIN=whisper\whisper-cli.exe
# HUDDLE_CLAUDE_BIN=claude

# --- Calls ------------------------------------------------------------------------
# Team glossary for whisper: данные\glossaries\<name>.txt
HUDDLE_GLOSSARY=староста
# Language of the calls: auto (default) — whisper hears it at 20, 50 and 80 % of each call;
# a code such as ru or en forces one (a wrong one loses speech)
HUDDLE_WHISPER_LANGUAGE=auto
# Who speaks: off (default) — a transcript without names; on — lit tiles, avatars and voices
HUDDLE_SPEAKERS=off
HUDDLE_TIMEZONE=Europe/Chisinau

# --- Slack ------------------------------------------------------------------------
# Bot token of the @huddle_notes app (xoxb-...)
SLACK_BOT_TOKEN=
# Channel ID (not the name), the member ID to @mention
SLACK_CHANNEL={{SLACK_CHANNEL}}
SLACK_NOTIFY_USER={{SLACK_NOTIFY_USER}}
