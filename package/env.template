# Call Recaps settings. Paths are relative to this folder (the watcher runs from here).
# Secrets are written here by the owner, never pasted into a chat.

# --- Folders --------------------------------------------------------------------
HUDDLE_DATA_DIR=данные
# HUDDLE_INBOX=Записи
# HUDDLE_RESULTS=Результаты

# --- Models -----------------------------------------------------------------------
HUDDLE_WHISPER_MODEL=large-v3-turbo
# Finds speech before whisper listens, so it doesn't repeat made-up phrases over long silence.
# Options: silero-v5.1.2 (default), off
HUDDLE_VAD_MODEL=silero-v5.1.2
HUDDLE_VOICE_MODEL=wespeaker-resnet34
HUDDLE_NOTES_MODEL=claude-opus-5-5
HUDDLE_WHISPER_BIN=whisper\whisper-cli.exe
# HUDDLE_CLAUDE_BIN=claude

# --- Calls ------------------------------------------------------------------------
# Team glossary for whisper and Claude: данные\glossaries\<name>.txt (староста: team Zinrai)
HUDDLE_GLOSSARY=староста
# Language of the calls: auto (default) — whisper hears it at 20, 50 and 80 % of each call;
# a code such as ru or en forces one (a wrong one loses speech)
HUDDLE_WHISPER_LANGUAGE=auto
# Who speaks: off (default) — a transcript without names; on — lit tiles, avatars and voices
HUDDLE_SPEAKERS=off
# Windows: a note in the corner of the screen when a new recording is taken into work;
# off switches it off; powershell shows it under Windows PowerShell's name, for a Windows
# that silently drops it under "Call Recaps". A trial one: huddle-notes notify-test
HUDDLE_DESKTOP_NOTIFY=on
HUDDLE_TIMEZONE=Europe/Chisinau

# --- Slack ------------------------------------------------------------------------
# Bot token (xoxb-...): of the shared @ai-recap app, or of your own Slack app
SLACK_BOT_TOKEN=
# ID of this installation's own channel (not the name). One channel, one installation:
# the program reads the replies under its bot's call messages in the channel, whoever sent
# them, so two installations with one bot in one channel would take each other's replies.
SLACK_CHANNEL={{SLACK_CHANNEL}}
# The owner's Slack member ID, @mentioned in every call and failure message; empty: none
SLACK_NOTIFY_USER={{SLACK_NOTIFY_USER}}
